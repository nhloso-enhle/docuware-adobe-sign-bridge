# =============================================================================
# DocuWare
# =============================================================================

DW_SERVER_URL=https://yourorg.docuware.cloud
DW_PLATFORM=DocuWare/Platform
DW_USERNAME=service-account@yourorg.com
DW_PASSWORD=YourSecurePassword
DW_CLIENT_ID=docuware.platform.net.client
DW_SCOPE=docuware.platform
DW_FILE_CABINET_ID=e6ecd4a1-fa7b-4644-b1fb-df7ce7e8cd2d

# x-docuware-signature verification (HMAC-SHA256, hex output)
# Found in: DocuWare Configuration -> Organization Settings -> Security tab
DW_ORGANIZATION_PASSPHRASE=your-docuware-org-passphrase

# Bearer token for the Workflow Web Service Activity path.
# DocuWare's Workflow Web Service Activity does NOT send x-docuware-signature
# automatically. Instead, configure the web service in DocuWare Configuration
# -> Web Services -> your service entry -> Authentication: Bearer Token,
# and paste the value of DW_BRIDGE_API_KEY as the token.
# The /webhooks/docuware endpoint then accepts EITHER:
#   x-docuware-signature  (Webhooks module -- sent automatically)
#   Authorization: Bearer (Web Service Activity -- configured above)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DW_BRIDGE_API_KEY=your-random-api-key-here

DW_STATUS_FIELD=STATUS
DW_STATUS_SIGNED_VALUE=Signed
DW_STATUS_PENDING_VALUE=Pending Signature
DW_SIGNATURE_URL_FIELD=E_SIGNATURE_URL

# Pipe-separated, case-insensitive text anchors used to find the letter.
# The end marker page is included; the next-section marker page is excluded.
DW_TRANSMITTAL_START_MARKERS=TRANSMITTAL LETTER|ENCLOSED PLEASE FIND
DW_TRANSMITTAL_END_MARKERS=END OF TRANSMITTAL
DW_TRANSMITTAL_NEXT_SECTION_MARKERS=GENERAL TERMS

# =============================================================================
# Adobe Acrobat Sign -- OAuth2
# =============================================================================
#
# APPLICATION TYPE
# ----------------
# When creating the OAuth application in Adobe Sign -> Account -> API Applications:
#   CUSTOMER = access only your own account  (use this for internal tools)
#   PARTNER  = access any authorized account (requires Adobe certification)
#
# If you need this bridge only for Ricoh's own Sign account, create a
# CUSTOMER application.  PARTNER apps will not have full account access
# until certified by Adobe.
#
# ONE-TIME SETUP
# --------------
# 1. Create application (CUSTOMER type recommended for internal use):
#    Adobe Sign -> Account -> Adobe Sign API -> API Applications -> Add
#    Enable scopes:
#      agreement_read:account  agreement_send:account
#      agreement_write:account webhook_read:account  webhook_write:account
#    Set a Redirect URI, e.g. https://your-domain.com/oauth/callback
#    Note the Client ID and Client Secret.
#
# 2. Open in browser (replace placeholders):
#    https://{your-sign-host}/public/oauth/v2
#      ?response_type=code
#      &client_id={CLIENT_ID}
#      &redirect_uri={REDIRECT_URI}
#      &scope=agreement_read:account+agreement_send:account+agreement_write:account+webhook_read:account+webhook_write:account
#    Authorize.  Browser redirects to redirect_uri with ?code=XXXXX (valid 5 min).
#
# 3. Exchange the code (POST, parameters in body -- NOT query string):
#    POST https://api.na4.adobesign.com/oauth/v2/token
#    Content-Type: application/x-www-form-urlencoded
#
#    grant_type=authorization_code
#    &code={CODE}
#    &client_id={CLIENT_ID}
#    &client_secret={CLIENT_SECRET}
#    &redirect_uri={REDIRECT_URI}
#
#    Response:
#    {
#      "access_token":    "...",
#      "refresh_token":   "...",                            <- ADOBE_SIGN_REFRESH_TOKEN
#      "expires_in":      3600,
#      "token_type":      "Bearer",
#      "api_access_point":"https://api.na4.adobesign.com/", <- ADOBE_SIGN_API_BASE_URL (strip /)
#      "web_access_point":"https://yourorg.na4.adobesign.com/"
#    }
#
# 4. Store api_access_point (strip trailing /) as ADOBE_SIGN_API_BASE_URL.
#    Store refresh_token as ADOBE_SIGN_REFRESH_TOKEN.
#    Refresh tokens expire after 60 days of inactivity.
# =============================================================================

ADOBE_SIGN_CLIENT_ID=UB7E5BXCXY
ADOBE_SIGN_CLIENT_SECRET=your-client-secret-here

# api_access_point from the Authorization Code token exchange (no trailing slash)
# This is the authoritative base for ALL Sign API and OAuth calls.
ADOBE_SIGN_API_BASE_URL=https://api.na4.adobesign.com

# refresh_token from the Authorization Code token exchange
ADOBE_SIGN_REFRESH_TOKEN=your-refresh-token-here

# Public HTTPS URL of this service (reachable by Adobe Sign servers)
ADOBE_SIGN_WEBHOOK_URL=https://your-public-domain.com

# =============================================================================
# DocuWare Webhook / Web Service Activity Body Template
# =============================================================================
#
# Configure the body in a DocuWare Workflow Web Service activity. The activity
# waits for the middleware to write E_SIGNATURE_URL before the workflow enters
# DocuWare's native Send Email activity.
#
# {
#   "documentId":    "{{DWDOCID}}",
#   "fileCabinetId": "e6ecd4a1-...",
#   "signers": [{ "email": "{{SIGNER_EMAIL}}", "name": "{{SIGNER_NAME}}" }],
#   "agreementName": "{{DOCUMENT_TYPE}} {{DOCUMENT_NUMBER}}",
#   "message":       "Please review and sign."
# }
#
# DocuWare automatically adds x-docuware-signature (HMAC-SHA512 hex of body,
# keyed with DW_ORGANIZATION_PASSPHRASE).

# =============================================================================
# Admin / Monitoring
# =============================================================================

ADMIN_API_KEY=your-admin-key-here

# =============================================================================
# Server
# =============================================================================

PORT=3000
NODE_ENV=production
LOG_LEVEL=info
